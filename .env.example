# Server-only authentication. Generate a long random session secret.
AUTH_PROVIDER=local
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=replace-with-a-strong-user-password
PUBLIC_APP_ORIGIN=https://your-deployment.example

# Corporate identity (server-only; required only when AUTH_PROVIDER=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_GROUP_ID=
ENTRA_USER_GROUP_ID=
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
ENTRA_CLOCK_SKEW_SECONDS=60
ENTRA_JWKS_CACHE_SECONDS=3600
ENTRA_TRUST_PROXY_HEADERS=false

# AI provider boundary (switch to an Azure/internal adapter during handoff)
AI_PROVIDER=openrouter
# Azure OpenAI/internal provider boundary (server-only; leave empty in the public MVP)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-10-21
# OpenRouter (never expose these variables to VITE_ or the browser)
# A quinta ferramenta, "Pesquisar novos parceiros", usa esta mesma chave com
# a ferramenta hospedada openrouter:web_search. Ela fica restrita a admins,
# entrega no máximo três sugestões e nunca grava sem revisão card por card.
OPENROUTER_API_KEY=replace-with-openrouter-key
# Every flow here demands strict JSON Schema output. A model that ignores it
# degrades in silence: the batch is discarded and the item keeps the source's
# own wording, which looks exactly like "there was nothing to rewrite".
#
# The pilot pins a model per task below. This generic model is used only by
# administrative checks and tasks without a specific assignment.
#
# A pinned model is cheaper and more predictable. Free candidates advertising
# support can be listed with:
#   curl -s https://openrouter.ai/api/v1/models | \
#     jq -r '.data[] | select(.pricing.prompt=="0" and (.supported_parameters//[]|index("structured_outputs"))) | .id'
#
# Advertised support is not proof — a smoke of the interview on 28/07/2026 had
# gemma-4-26b at 8/8 valid, nemotron-3-super at 0/5 (dropping required
# properties) and gpt-oss-20b at 0/1. Measure a candidate against the real
# schema before adopting it:
#   npm run ai:smoke -- --model=<id> --runs=5
# The interview is the stricter test of the two, because it also asks the model
# to reason before writing the question (read the situation, weigh alternative
# angles, refuse to presume the venue or the audience). Smoke it separately
# before pinning a model for the selection tool:
#   npm run ai:smoke -- --task=interview --model=<id> --runs=5
# Avoid openrouter/free: it picks a free model at random, so a green smoke says
# nothing about the next request.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
AI_MODEL_INTERVIEW=openai/gpt-5-mini
AI_MODEL_SELECTION=openai/gpt-5-mini
AI_MODEL_CATALOG_RESEARCH=openai/gpt-5-mini
AI_MODEL_CATALOG_ENRICHMENT=google/gemma-4-26b-a4b-it
AI_MODEL_RADAR_EDITORIAL=google/gemma-4-26b-a4b-it
AI_MODEL_RADAR_SUMMARY=google/gemma-4-26b-a4b-it
AI_CACHE_TTL_HOURS=168
AI_PILOT_WARNING_USD=8
AI_PILOT_CRITICAL_USD=9.5
AI_ENFORCE_BUDGET=false
SELECTION_AI_CANDIDATE_LIMIT=15
# Only applies to openrouter/auto; a pinned model ignores it. 0 to 10.
OPENROUTER_COST_QUALITY_TRADEOFF=7
# The interview overrides it: one badly written question costs the whole
# conversation, while a Radar item rewritten in bulk does not. Same scale, and
# it also only applies to openrouter/auto. Default 4 — above the general
# setting, but deliberately not 10: at 10 the router picked heavyweight
# reasoning models that blew past the 45s limit and never answered at all. On
# an interactive call, a model that does not answer in time is worth less than
# a good one that does. Raise it only with a pinned fast model.
INTERVIEW_COST_QUALITY_TRADEOFF=4
# Writing a question is not extraction: at the extraction temperature the
# interview asks near-identical questions across sessions. 0 to 1.2, default 0.7.
INTERVIEW_TEMPERATURE=0.7
# A entrevista lê a situação, declara pressupostos e rascunha candidatas antes
# de escrever a pergunta, e pede qualidade ao roteador: isso leva segundos.
# Mantenha abaixo do maxDuration da função em vercel.json. 5000 a 50000.
# Internal reasoning is off by default: the interview schema already demands the
# reasoning in its own auditable fields, so a reasoning model would think twice
# and only half of it would be recorded — at double the wall-clock cost. A
# reasoning model spent 54 tokens thinking to answer 7 tokens of content, which
# is what pushed every interview call past its time limit. Set to low, medium or
# high to turn it back on.
OPENROUTER_REASONING=
INTERVIEW_TIMEOUT_MS=45000

# Pesquisa profunda trabalha em lotes; mantenha abaixo do maxDuration de api/admin.js.
CATALOG_RESEARCH_TIMEOUT_MS=180000
# Limites específicos para pesquisas profundas (opcionais).
CATALOG_RESEARCH_DAILY_REQUEST_LIMIT=100
CATALOG_RESEARCH_DAILY_TOKEN_LIMIT=1000000
CATALOG_RESEARCH_DAILY_COST_LIMIT_USD=25
# Num modelo de raciocínio os tokens de pensamento contam contra este teto, e
# uma resposta cortada no meio chega como JSON inválido. Teto do sistema: 16000.
INTERVIEW_MAX_OUTPUT_TOKENS=1400
RADAR_LIVE_SOURCES=true
# NOT optional once a live run has anything to rewrite. An item shown in the
# source's own wording is indistinguishable from an item that needed no
# rewriting, so that degradation is invisible to the reader — the run fails
# instead. A collection with nothing pending still succeeds without these.
# Set both to the configured server-side AI provider (e.g. openrouter).
RADAR_SUMMARY_PROVIDER=
RADAR_EDITORIAL_PROVIDER=
RADAR_TRACKED_RESEARCHER_LIMIT=8
RADAR_DOU_ENABLED=true
RADAR_DOU_SECTIONS=DO1,DO3
RADAR_DOU_TIMEZONE=America/Sao_Paulo
RADAR_DOU_LOOKBACK_DAYS=3
RADAR_DISCOVERY_PROVIDER=direct
RADAR_EXTRACT_PROVIDER=tavily
TAVILY_API_KEY=replace-with-tavily-key
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=20
TAVILY_DAILY_CREDIT_LIMIT=100
# JSON opcional; somente nomes presentes na allowlist oficial e URLs HTTPS são aceitos.
RADAR_EXTRA_FEEDS_JSON=[]
RADAR_CRON_SECRET=replace-with-a-long-cron-secret
CRON_SECRET=
# Um valor só, não a lista: memory, file ou vercel_blob. Copiar a lista
# inteira produz um driver inválido, que vira memory sem avisar — e em
# serverless memory significa que nada persiste entre invocações.
RADAR_STORE_DRIVER=supabase
RADAR_STORE_FILE=
CATALOG_STORE_DRIVER=supabase
CATALOG_STORE_FILE=
CATALOG_BLOB_PATH=senai/catalog/manifest.json
RADAR_BLOB_PATH=senai/radar/snapshot.json
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENROUTER_SITE_URL=https://your-deployment.example
OPENROUTER_APP_NAME=SENAI-SP Parceiros
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_COST_LIMIT_USD=25
AI_DAILY_REQUEST_LIMIT=100
CATALOG_ENRICHMENT_DAILY_TOKEN_LIMIT=1000000
CATALOG_ENRICHMENT_DAILY_COST_LIMIT_USD=10
CATALOG_ENRICHMENT_DAILY_REQUEST_LIMIT=150
AI_ESTIMATED_COST_PER_1K_USD=0.01
AI_BUDGET_STORE_DRIVER=supabase
AI_BUDGET_STORE_FILE=
AI_BUDGET_BLOB_PATH=senai/ai/usage-budget.json
RATE_LIMIT_STORE_DRIVER=memory
RATE_LIMIT_STORE_FILE=
RATE_LIMIT_BLOB_PATH=senai/security/rate-limits.json
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
AI_ALERT_THRESHOLD=0.8

# Supabase is server-only. Never prefix these with VITE_ and never expose the
# service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

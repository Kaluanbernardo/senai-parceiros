# Server-only authentication. Generate a long random session secret.
AUTH_PROVIDER=local
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=replace-with-a-strong-user-password
PUBLIC_APP_ORIGIN=https://your-deployment.example

# Corporate identity (server-only; required only when AUTH_PROVIDER=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_GROUP_ID=
ENTRA_USER_GROUP_ID=
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
ENTRA_CLOCK_SKEW_SECONDS=60
ENTRA_JWKS_CACHE_SECONDS=3600
ENTRA_TRUST_PROXY_HEADERS=false

# AI provider boundary (switch to an Azure/internal adapter during handoff)
AI_PROVIDER=openrouter
# Azure OpenAI/internal provider boundary (server-only; leave empty in the public MVP)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-10-21
# OpenRouter (never expose these variables to VITE_ or the browser)
OPENROUTER_API_KEY=replace-with-openrouter-key
# Every flow here demands strict JSON Schema output. A model that ignores it
# degrades in silence: the batch is discarded and the item keeps the source's
# own wording, which looks exactly like "there was nothing to rewrite".
#
# openrouter/auto is the default because the request already carries
# `require_parameters: true` (see server/lib/structuredGeneration.js), which
# restricts routing to providers that accept the schema. It bills per request
# and its price varies with the model chosen.
#
# A pinned model is cheaper and more predictable. Free candidates advertising
# support can be listed with:
#   curl -s https://openrouter.ai/api/v1/models | \
#     jq -r '.data[] | select(.pricing.prompt=="0" and (.supported_parameters//[]|index("structured_outputs"))) | .id'
#
# Advertised support is not proof — a smoke of the interview on 28/07/2026 had
# gemma-4-26b at 8/8 valid, nemotron-3-super at 0/5 (dropping required
# properties) and gpt-oss-20b at 0/1. Measure a candidate against the real
# schema before adopting it:
#   npm run ai:smoke -- --model=<id> --runs=5
# The interview is the stricter test of the two, because it also asks the model
# to reason before writing the question (read the situation, weigh alternative
# angles, refuse to presume the venue or the audience). Smoke it separately
# before pinning a model for the selection tool:
#   npm run ai:smoke -- --task=interview --model=<id> --runs=5
# Avoid openrouter/free: it picks a free model at random, so a green smoke says
# nothing about the next request.
OPENROUTER_MODEL=openrouter/auto
# Only applies to openrouter/auto; a pinned model ignores it. 0 to 10.
OPENROUTER_COST_QUALITY_TRADEOFF=7
# The interview overrides it: one badly written question costs the whole
# conversation, while a Radar item rewritten in bulk does not. Same scale, and
# it also only applies to openrouter/auto. Default 10.
INTERVIEW_COST_QUALITY_TRADEOFF=10
# Writing a question is not extraction: at the extraction temperature the
# interview asks near-identical questions across sessions. 0 to 1.2, default 0.7.
INTERVIEW_TEMPERATURE=0.7
RADAR_LIVE_SOURCES=true
# Optional: set to the configured server-side AI provider to summarize new
# research abstracts. Empty/false/off keeps the evidence-based extractive mode.
RADAR_SUMMARY_PROVIDER=
RADAR_TRACKED_RESEARCHER_LIMIT=8
RADAR_DOU_ENABLED=true
RADAR_DOU_SECTIONS=DO1,DO3
RADAR_DOU_TIMEZONE=America/Sao_Paulo
RADAR_DOU_LOOKBACK_DAYS=3
RADAR_DISCOVERY_PROVIDER=direct
RADAR_EXTRACT_PROVIDER=tavily
TAVILY_API_KEY=replace-with-tavily-key
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=20
TAVILY_DAILY_CREDIT_LIMIT=100
# JSON opcional; somente nomes presentes na allowlist oficial e URLs HTTPS são aceitos.
RADAR_EXTRA_FEEDS_JSON=[]
RADAR_CRON_SECRET=replace-with-a-long-cron-secret
CRON_SECRET=
RADAR_STORE_DRIVER=memory|file|vercel_blob
RADAR_STORE_FILE=
CATALOG_STORE_DRIVER=memory|file|vercel_blob
CATALOG_STORE_FILE=
CATALOG_BLOB_PATH=senai/catalog/manifest.json
RADAR_BLOB_PATH=senai/radar/snapshot.json
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENROUTER_SITE_URL=https://your-deployment.example
OPENROUTER_APP_NAME=SENAI-SP Parceiros
AI_DAILY_TOKEN_LIMIT=100000
AI_DAILY_COST_LIMIT_USD=25
AI_DAILY_REQUEST_LIMIT=100
AI_ESTIMATED_COST_PER_1K_USD=0.01
AI_BUDGET_STORE_DRIVER=memory|file|vercel_blob
AI_BUDGET_STORE_FILE=
AI_BUDGET_BLOB_PATH=senai/ai/usage-budget.json
RATE_LIMIT_STORE_DRIVER=memory|file|vercel_blob
RATE_LIMIT_STORE_FILE=
RATE_LIMIT_BLOB_PATH=senai/security/rate-limits.json
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
AI_ALERT_THRESHOLD=0.8

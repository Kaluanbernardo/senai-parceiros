{
  "rewrites": [
    { "source": "/api/admin/:action", "destination": "/api/admin?action=:action" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/radar/refresh.js": { "maxDuration": 60 },
    "api/selection/interview-next.js": { "maxDuration": 60 },
    "api/selection/evaluate.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/radar/refresh", "schedule": "0 12 * * *" }
  ]
}
